# Data: raw, interim, processed, demo, evaluator-only, and local runtime state.
# Directories are kept in Git via a tracked .gitkeep; contents are regenerated by `make data`.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/demo/*
!data/demo/.gitkeep
data/evaluation/*
!data/evaluation/.gitkeep
data/local/*
!data/local/.gitkeep

# Trained model artifacts (regenerate with `make final`; sha256 recorded in models/manifest.json)
models/*.joblib
models/candidates/
*.pkl

# Local action logs and exports (constitution Principle XI)
*.sqlite
*.sqlite3
*.db

